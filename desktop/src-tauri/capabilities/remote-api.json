{
  "identifier": "remote-api",
  "description": "Allow Tauri IPC when webview is navigated to local API",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*", "http://localhost:*"]
  },
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "core:event:default",
    "allow-runtime-status",
    "allow-runtime-set-mirror",
    "allow-runtime-install-start",
    "allow-runtime-install-cancel",
    "allow-runtime-stop-api",
    "allow-runtime-start-api",
    "allow-runtime-open-setup"
  ]
}
