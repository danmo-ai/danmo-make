{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Danmo Make",
  "version": "0.1.15",
  "identifier": "com.danqing.studio.desktop",
  "build": {
    "beforeDevCommand": "bash ../scripts/ensure_tauri_resource_stub.sh && cd ../frontend && npm run dev",
    "beforeBuildCommand": "",
    "devUrl": "http://127.0.0.1:5800/",
    "frontendDist": "../loader"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Danmo Make",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default",
        "remote-api"
      ]
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Danmo Make desktop",
    "longDescription": "Native shell for the Danmo Make FastAPI server (REST).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "danqing-api",
      "runtime"
    ]
  }
}
