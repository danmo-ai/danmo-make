{
  "name": "danmo-make-frontend",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fresh": "rm -rf node_modules/.vite && vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "canvas-unit": "npx --yes tsx src/utils/canvasEdges.unit.ts && npx --yes tsx src/utils/canvasExtendPreview.unit.ts && npx --yes tsx src/utils/canvasStaging.unit.ts && npx --yes tsx src/utils/registryParamSchema.unit.ts && npx --yes tsx src/utils/genTaskLog.unit.ts"
  },
  "dependencies": {
    "@danqing/dq-shell": "file:../../dq-ui/packages/shell",
    "@danqing/dq-tokens": "file:../../dq-ui/packages/tokens",
    "@danqing/dq-ui": "file:../../dq-ui/packages/ui",
    "@tauri-apps/api": "^2.12.2",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.13",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.12"
  }
}
